{
  "manifest_version": "0.3",
  "name": "k17",
  "display_name": "K17",
  "version": "0.1.0",
  "description": "Design with Claude on a shared K17 canvas. Create, edit and review designs together in real time.",
  "author": { "name": "K17", "url": "https://k17.dpdns.org" },
  "homepage": "https://k17.dpdns.org",
  "documentation": "https://github.com/dangkhoabui15092004-byte/doop/tree/khoadev-next/plugins/k17",
  "support": "https://github.com/dangkhoabui15092004-byte/doop/issues",
  "repository": { "type": "git", "url": "https://github.com/dangkhoabui15092004-byte/doop" },
  "license": "AGPL-3.0-only",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "node_modules/mcp-remote/dist/proxy.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/node_modules/mcp-remote/dist/proxy.js",
        "${user_config.server_url}",
        "--transport",
        "http-only",
        "--auth-timeout",
        "300",
        "--static-oauth-client-metadata",
        "{\"client_name\":\"K17 for Claude Desktop\",\"client_uri\":\"https://k17.dpdns.org\"}"
      ]
    }
  },
  "user_config": {
    "server_url": {
      "type": "string",
      "title": "K17 server URL",
      "description": "Your K17 server's URL followed by /mcp. HTTPS is required except on localhost.",
      "default": "https://k17.dpdns.org/mcp",
      "required": true
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32"],
    "runtimes": { "node": ">=20.18.1" }
  },
  "tools_generated": true,
  "keywords": ["design", "canvas", "html", "css", "multiplayer", "k17"]
}
